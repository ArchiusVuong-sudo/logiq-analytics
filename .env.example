# Supabase — required for the app to read/write the orders table.
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx

# Optional — server-side fallback keys. If set, the deployed app will use these
# when a user has not provided their own via Settings. Recommended: leave blank
# in production so reviewers/users bring their own key.
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=AIza...
